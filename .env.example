# 火焰纹章Engage培养助手 配置模板
# 用法: 复制本文件为 .env 并填入真实值 ( .env 已被 gitignore, 密钥不会入库 )
# 任何 OpenAI 兼容端点都可用: DeepSeek / Qwen / GLM / Kimi / 中转站 / OpenAI官方

# 必填: API密钥
OPENAI_API_KEY=

# 可选: 接口地址 (默认 https://api.openai.com/v1)
# OPENAI_BASE_URL=https://api.deepseek.com/v1

# 可选: 模型名 (默认 gpt-4o-mini)
# AGENT_MODEL=deepseek-chat

# 可选: 单轮工具循环上限 / 上下文字符预算 / 工具调用轨迹(1开启)
# AGENT_MAX_ITERATIONS=8
# AGENT_CONTEXT_BUDGET=60000
# AGENT_VERBOSE=1
